# Supabase — these are safe to use in the browser (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Fathom Analytics (public site only; optional)
# NEXT_PUBLIC_FATHOM_SITE_ID=ABCDEFGH

# Optional. Next.js does not need a service role key for photo sync or staff invites.
# Those run in Edge Functions (service role stays on Supabase).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt
# SUPABASE_SECRET_KEY=sb_secret_...

# Deploy Edge Functions after changing this repo:
#   supabase functions deploy get-stallion-image-signed-url
#   supabase functions deploy invite-staff
#   supabase functions deploy sync-stallion-public-photos
